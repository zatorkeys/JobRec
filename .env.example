# Copy file này thành .env rồi điền key. KHÔNG commit file .env
OPENAI_API_KEY=
GEMINI_API_KEY=
# Key Gemini thứ 2 (và 3, tuỳ chọn): dùng luân phiên, key nào hết quota ngày thì tự chuyển sang key kia.
# Quota miễn phí tính theo PROJECT Google Cloud → key 2 phải tạo ở PROJECT KHÁC (AI Studio → Create API key →
# "Create API key in new project"), nếu cùng project thì không có thêm quota.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Model (tuỳ chọn, đổi nếu tài khoản của bạn dùng model khác)
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING=low

# Vai trò: OpenAI không dùng được (hết credit, sai key) → tự chuyển hết sang Gemini
PIPELINE_LLM=gemini
JUDGE_MAIN=openai
JUDGE_SECOND=gemini

# Gọi LLM tiết kiệm: số tin gom vào 1 lời gọi khi trích kỹ năng JD; số request/phút mỗi model mỗi key
JD_BATCH=8
GEMINI_RPM=10

# Số request LLM song song (giảm nếu bị lỗi 429)
LLM_WORKERS=4
